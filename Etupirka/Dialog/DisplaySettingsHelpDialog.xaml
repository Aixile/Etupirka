<Controls:MetroWindow x:Class="Etupirka.Dialog.DisplaySettingsHelpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:Views="clr-namespace:Etupirka.Views"
        xmlns:loc="clr-namespace:Etupirka.Localization"
        WindowStartupLocation="CenterOwner"
        Title="{loc:Loc Dialog_Help_Title}" Height="250" Width="430"
        WindowTitleBrush="#FF252525"
        GlowBrush="{DynamicResource AccentColorBrush}"
        BorderThickness="1.5"
        TitleCaps="False"
        >
    <Grid>
        <TextBlock Foreground="#fff" Margin="20" TextWrapping="WrapWithOverflow">
            <TextBlock FontWeight="Bold" Text="{loc:Loc DisplayHelp_Lead}" /><Run Text="{loc:Loc DisplayHelp_Suffix}" />
            <LineBreak/>
            <LineBreak/>
            <Run Text="{loc:Loc DisplayHelp_Intro}" />
            <LineBreak/>
            <Run Text="{loc:Loc DisplayHelp_Step1}" />
            <LineBreak/>
            <Run Text="{loc:Loc DisplayHelp_Step2}" />
            <LineBreak/>
            <Run Text="{loc:Loc DisplayHelp_Step3}" />
            <LineBreak/>
            <Run Text="{loc:Loc DisplayHelp_Step4}" />
            <LineBreak/>
            <Run Text="{loc:Loc DisplayHelp_End}" />
            
        </TextBlock>

    </Grid>
</Controls:MetroWindow>
